/* =====================================================
   Radio dans les menus : complète Menu.uss, sans le modifier.
   À charger APRÈS Menu.uss dans MainMenu.uxml et InGameMenu.uxml
   (c'est le dernier fichier chargé qui l'emporte).
   ===================================================== */

/* ---------- Menu en jeu : place pour le bouton RADIO ---------- */

/* 40 pixels de plus que dans Menu.uss. La même taille est écrite dans InGameMenu.cs (Size). */
.menu--ingame {
    height: 820px;
}

/* Boutons du bas sur deux étages : RADIO, puis la rangée habituelle */
.actions--stacked {
    flex-direction: column;
}

.actions__row {
    flex-direction: row;
    margin-top: 12px;
}

/* ---------- Choix de la radio : < NOM > ---------- */

.radio__station {
    flex-direction: row;
    align-items: center;
    margin-top: 16px;
}

/* Flèches : largeur fixe, le nom prend le reste */
.menu .radio__arrow {
    flex-grow: 0;
    flex-basis: auto;
    width: 78px;
    padding: 0;
    font-size: 40px;
}

.menu .radio__station-name {
    flex-grow: 1;
    flex-basis: 0;
    font-size: 42px;
    color: rgb(255, 204, 0);
    letter-spacing: 2px;
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* ---------- Morceau en cours ---------- */

.radio__now {
    flex-direction: row;
    align-items: center;
    margin-top: 14px;
    padding: 10px;
    background-color: rgb(26, 26, 26);
    border-left-width: 6px;
    border-left-color: rgb(255, 106, 0);
    transition-duration: 0.15s;
}

.radio__cover {
    width: 96px;
    height: 96px;
    flex-shrink: 0;
    background-color: rgb(46, 46, 46);
    background-size: cover;
}

.radio__infos {
    flex-grow: 1;
    flex-basis: 0;
    margin-left: 14px;
    justify-content: center;
    overflow: hidden;
}

.menu .radio__infos .unity-label {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.menu .radio__tag {
    font-size: 18px;
    color: rgb(255, 106, 0);
    letter-spacing: 2px;
}

.menu .radio__title {
    font-size: 32px;
}

.menu .radio__artist {
    font-size: 24px;
    color: rgb(255, 204, 0);
}

.menu .radio__album {
    font-size: 20px;
    color: rgb(150, 150, 150);
}

/* Radio coupée ou sans morceau : le bloc passe en grisé (classe posée par le script) */
.radio--off .radio__now {
    opacity: 0.4;
}

/* ---------- Précédent / suivant ---------- */

.radio__tracks {
    margin-top: 10px;
}

.menu .radio__tracks .choice__button {
    height: 52px;
    font-size: 30px;
}

.menu .radio .choice__button:disabled {
    -unity-background-image-tint-color: rgb(34, 34, 34);
    color: rgb(90, 90, 90);
}

/* ---------- Volume : un peu plus serré que dans les paramètres ---------- */

.radio .setting {
    margin-top: 14px;
}
